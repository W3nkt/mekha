{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mekha-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": { "crons": ["0 2 * * *"] },
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "development",
    "ALLOWED_ORIGIN": "http://localhost:5173",
    "SUPABASE_URL": "https://mjgcivpsboccmstphyox.supabase.co",
  },
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "AUTHENTICATED_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 300, "period": 60 },
    },
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
  "env": {
    "staging": {
      "name": "mekha-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "ALLOWED_ORIGIN": "https://staging.mekha.app",
        "SUPABASE_URL": "https://mjgcivpsboccmstphyox.supabase.co",
      },
      "ratelimits": [
        {
          "name": "PUBLIC_RATE_LIMITER",
          "namespace_id": "1101",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1102",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "AUTHENTICATED_RATE_LIMITER",
          "namespace_id": "1103",
          "simple": { "limit": 300, "period": 60 },
        },
      ],
    },
    "production": {
      "name": "mekha-api",
      "vars": {
        "ENVIRONMENT": "production",
        "ALLOWED_ORIGIN": "https://mekha.satsx.net",
        "SUPABASE_URL": "https://mjgcivpsboccmstphyox.supabase.co",
      },
      "ratelimits": [
        {
          "name": "PUBLIC_RATE_LIMITER",
          "namespace_id": "1201",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1202",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "AUTHENTICATED_RATE_LIMITER",
          "namespace_id": "1203",
          "simple": { "limit": 300, "period": 60 },
        },
      ],
    },
  },
}
