# Public Supabase values. These may be exposed to browser clients.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server-only. Store this as a Cloudflare Worker secret; never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase CLI linking (the project ref is not a secret).
SUPABASE_PROJECT_REF=your-project-ref

# Server/local Supabase Auth configuration. Never expose these to the frontend.
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=your-twilio-account-sid
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=your-message-service-sid
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=your-twilio-auth-token
